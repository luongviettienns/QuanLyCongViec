# ==========================================
# TaskFlow Backend Dockerfile (NestJS + Prisma)
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Install openssl for Prisma
RUN apk add --no-cache openssl libc6-compat

# Copy package manifests
COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/
COPY apps/worker/package*.json ./apps/worker/
COPY packages/shared/package*.json ./packages/shared/

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Copy source code and Prisma schema
COPY packages/shared ./packages/shared
COPY apps/backend ./apps/backend

# Generate Prisma Client & Build
RUN npx prisma generate --schema=apps/backend/prisma/schema.prisma
RUN npm run build:shared
RUN npm run build:backend

# Clean production dependencies stage (avoids npm prune workspace bug)
FROM node:24-alpine AS prod-deps

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/
COPY apps/worker/package*.json ./apps/worker/
COPY packages/shared/package*.json ./packages/shared/
COPY apps/backend/prisma ./apps/backend/prisma

RUN npm ci --omit=dev --workspace=@taskflow/backend --workspace=@taskflow/shared --include-workspace-root && \
    npm install --prefix /opt/prisma-cli --no-save --no-audit --no-fund prisma@6.19.3 && \
    /opt/prisma-cli/node_modules/.bin/prisma generate --schema=apps/backend/prisma/schema.prisma && \
    test -d /app/apps/backend/node_modules/@nestjs/platform-express && \
    test -d /app/node_modules/@prisma/client && \
    mkdir -p /app/packages/shared/node_modules

# Production image
FROM node:24-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl dumb-init

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=prod-deps --chown=node:node /app/package*.json ./
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=prod-deps --chown=node:node /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=prod-deps --chown=node:node /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=prod-deps --chown=node:node /opt/prisma-cli ./prisma-cli
COPY --from=builder --chown=node:node /app/packages/shared ./packages/shared
COPY --from=builder --chown=node:node /app/apps/backend/package*.json ./apps/backend/
COPY --from=builder --chown=node:node /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=builder --chown=node:node /app/apps/backend/dist ./apps/backend/dist

USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/backend/dist/config/run-with-vault.js", "sh", "-c", "./prisma-cli/node_modules/.bin/prisma migrate deploy --schema=apps/backend/prisma/schema.prisma && node apps/backend/dist/main.js"]
