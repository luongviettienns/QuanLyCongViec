# Copy this file to `.env` at the repo root before running `docker compose up -d`
# Do NOT commit `.env` to Git.

# PostgreSQL
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=taskflow
POSTGRES_PORT=5433

# Backend Security & Auth
JWT_SECRET=replace_with_random_string_at_least_32_characters
JWT_EXPIRATION=7d
INTERNAL_API_KEY=replace_with_random_internal_api_secret
CORS_ORIGINS=http://localhost

# AI Assistant (choose provider: openai-compatible | anthropic | gemini)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://modelapi.vn/v1
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2048
