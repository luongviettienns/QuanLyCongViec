{
  "name": "@taskflow/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vault": {
      "types": "./dist/vault-env.d.ts",
      "default": "./dist/vault-env.js"
    },
    "./rabbitmq": {
      "types": "./dist/rabbitmq.d.ts",
      "default": "./dist/rabbitmq.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "amqplib": "^2.4.1"
  }
}
