generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum CollaboratorStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_RETURNED
  TASK_DEADLINE_CHANGED
  TASK_DEADLINE_SOON
  TASK_OVERDUE
  TASK_DELETED
  TASK_MOVED_TEAM
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  TEAM_ROLE_CHANGED
  TEAM_OWNERSHIP_TRANSFERRED
  TEAM_DELETED
  TEAM_INVITED
  DEADLINE_SOON
  TASK_COLLABORATOR_INVITED
  TASK_COLLABORATOR_ACCEPTED
  TASK_COLLABORATOR_DECLINED
  TASK_COLLABORATOR_REMOVED
  SUBTASK_ASSIGNED
  SUBTASK_UNASSIGNED
  SUBTASK_STATUS_CHANGED
  SUBTASK_COMPLETED
  SUBTASK_REOPENED
}

model User {
  id                     Int            @id @default(autoincrement())
  email                  String         @unique
  name                   String
  passwordHash           String

  createdTasks           Task[]         @relation("CreatedTasks")
  assignedTasks          Task[]         @relation("AssignedTasks")
  deletedTasks           Task[]         @relation("DeletedTasks")

  ownedTeams             Team[]         @relation("TeamOwner")
  teamMembers            TeamMember[]

  categories             Category[]
  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  collaborations         TaskCollaborator[] @relation("TaskCollaboratorUser")
  invitedCollaborations  TaskCollaborator[] @relation("TaskCollaboratorInvitedBy")
  assignedSubtasks       Subtask[]          @relation("SubtaskAssignee")
  createdSubtasks        Subtask[]          @relation("SubtaskCreator")
  completedSubtasks      Subtask[]          @relation("SubtaskCompleter")

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@map("User")
}

model Team {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?

  ownerId       Int
  owner         User           @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       TeamMember[]
  tasks         Task[]
  categories    Category[]
  notifications Notification[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("Team")
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("TeamMember")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#1890ff")

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
  @@map("Category")
}

model Task {
  id            Int            @id @default(autoincrement())

  userId        Int
  user          User           @relation("CreatedTasks", fields: [userId], references: [id], onDelete: Cascade)

  assigneeId    Int?
  assignee      User?          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  teamId        Int?
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(MEDIUM) @map("Priority")
  position      Int            @default(0)

  startDate     DateTime?      @db.Date
  dueDate       DateTime?      @db.Date

  categoryId    Int?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  notifications Notification[]
  collaborators TaskCollaborator[]
  subtasks      Subtask[]

  deletedAt     DateTime?
  deletedById   Int?
  deletedBy     User?          @relation("DeletedTasks", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([deletedAt])
  @@index([userId, status, position])
  @@index([teamId, status])
  @@index([assigneeId, status])
  @@map("Task")
}

model Notification {
  id            Int              @id @default(autoincrement())

  userId        Int
  user          User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId       Int?
  actor         User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type          NotificationType
  title         String
  content       String
  isRead        Boolean          @default(false)
  readAt        DateTime?
  invalidatedAt DateTime?

  taskId        Int?
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  subtaskId     Int?
  subtask       Subtask?         @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  teamId        Int?
  team          Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  eventKey      String?          @unique

  createdAt     DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([subtaskId])
  @@map("Notification")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("SystemSetting")
}

model TaskCollaborator {
  id          Int                @id @default(autoincrement())

  taskId      Int
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId      Int
  user        User               @relation("TaskCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)

  status      CollaboratorStatus @default(PENDING)

  invitedById Int
  invitedBy   User               @relation("TaskCollaboratorInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  invitedAt   DateTime           @default(now())
  respondedAt DateTime?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([taskId, userId])
  @@index([taskId, status])
  @@index([userId, status])
  @@map("TaskCollaborator")
}

model Subtask {
  id          Int        @id @default(autoincrement())

  taskId      Int
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)

  assigneeId  Int?
  assignee    User?      @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById Int
  createdBy   User       @relation("SubtaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  completedById Int?
  completedBy   User?      @relation("SubtaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  notifications   Notification[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  deletedWithTask Boolean    @default(false)

  @@index([taskId, deletedAt, position])
  @@index([assigneeId, status])
  @@index([completedById])
  @@map("Subtask")
}
