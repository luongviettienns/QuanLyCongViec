# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskflow?schema=public"

# Authentication (JWT)
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters"
JWT_EXPIRATION="7d"

# Internal Automation & Scheduled Worker API Key (fail-closed if omitted)
INTERNAL_API_KEY="replace_with_secure_internal_api_secret_for_cron_and_workers"
